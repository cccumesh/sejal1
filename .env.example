# ─── Local dev (.env) — direct browser calls ───
VITE_GEMINI_API_KEY=your_google_ai_studio_api_key_here
#
# ElevenLabs TTS (optional — set false when using Inworld)
VITE_ELEVENLABS_ENABLED=false
# VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# VITE_ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here
#
# Inworld TTS (recommended for Myra — [laugh]/[sigh] tags)
VITE_INWORLD_ENABLED=true
VITE_INWORLD_API_KEY=your_inworld_api_key_here
VITE_INWORLD_VOICE_ID=your_inworld_voice_id_here
VITE_INWORLD_SPEAKING_RATE=1.0
#
# ─── Netlify production (secure proxy — NOT in .env file) ───
# Set in Netlify dashboard only (Functions + Runtime + Build scope):
#   GEMINI_API_KEY=same_as_VITE_GEMINI_API_KEY_above
#   VITE_ELEVENLABS_ENABLED=true
#   ELEVENLABS_API_KEY=...
#   ELEVENLABS_VOICE_ID=...
# Do NOT set VITE_ELEVENLABS_API_KEY or VITE_GEMINI_API_KEY on Netlify (key leak protection).
# Health check after deploy: https://yoursite.netlify.app/.netlify/functions/gemini
#
# Deepgram STT (local): Nova-3 multilingual — better Hinglish on iPhone Safari
VITE_DEEPGRAM_ENABLED=true
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Optional: VITE_DEEPGRAM_MODEL=nova-3  VITE_DEEPGRAM_LANGUAGE=multi
# Optional: VITE_TTS_PLAYBACK_GAIN=1.0  (1.0 = normal; 1.2–1.4 = louder via Web Audio)
# Optional Netlify: DEEPGRAM_KEYTERMS=Sejal,Chetan,... (comma names for STT hints)
#
# Netlify production (server-only — Functions + Runtime scope):
#   VITE_DEEPGRAM_ENABLED=true
#   DEEPGRAM_API_KEY=same_as_VITE_DEEPGRAM_API_KEY_above
# Do NOT set VITE_DEEPGRAM_API_KEY on Netlify (key leak protection).
#
# Get a free Gemini key: https://aistudio.google.com/apikey
# ElevenLabs: https://elevenlabs.io → Profile → API Keys + Voices
#
# Supabase ledger (public anon key is OK in frontend)
VITE_DASHBOARD_PATH=axerai-insights-7k2m
VITE_DASHBOARD_PASSWORD=your_strong_dashboard_password
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here
